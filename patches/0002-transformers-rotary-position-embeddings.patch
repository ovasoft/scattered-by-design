+# ── Compatibility patch (2026 rebuttal) ──────────────────────────────────────
+# Newer transformers versions compute LLaMA rotary embeddings at the model
+# level and pass position_embeddings=(cos, sin) down to each decoder layer.
+# Calling a layer standalone without that tuple crashes inside attention
+# ("cannot unpack non-iterable NoneType object"). We capture the tuple in the
+# calibration Catcher and forward it to every standalone layer call. The
+# kwargs.get(..., None) guard keeps this backward-compatible with older
+# transformers (where the kwarg does not exist and layers compute rotary
+# internally).
+
+def _layer_kwargs(attention_mask, position_ids, position_embeddings):
+    kw = {"attention_mask": attention_mask, "position_ids": position_ids}
+    if position_embeddings is not None:
+        kw["position_embeddings"] = position_embeddings
+    return kw
+
+def _move(obj, dev):
+    if obj is None:
+        return None
+    if isinstance(obj, (tuple, list)):
+        return tuple(t.to(dev) for t in obj)
+    return obj.to(dev)
+# ─────────────────────────────────────────────────────────────────────────────
 
